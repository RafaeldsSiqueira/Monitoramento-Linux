              "id": "asterisk-alert",
              "leftValue": "={{ $json.labels.alertname }}",
              "rightValue": "AsteriskOffline",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
