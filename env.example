# =============================================================================
# ENV.EXAMPLE - SISTEMA DE MONITORAMENTO LINUX
# =============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias
# COPIE este arquivo para .env e preencha com seus valores reais
# NUNCA comite o arquivo .env real no GitHub!
# =============================================================================

# =============================================================================
# 🔑 CONFIGURAÇÕES DA API GOOGLE GEMINI
# =============================================================================
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_api_gemini_aqui

# =============================================================================
# 📧 CONFIGURAÇÕES DE EMAIL
# =============================================================================
# Email para envio de relatórios e notificações
EMAIL_ADDRESS=seu_email@gmail.com

# Senha do email (use senha normal ou "Acesso a app menos seguro" para Gmail)
EMAIL_PASSWORD=sua_senha_do_email

# Email para auditoria de ações automatizadas
AUDIT_EMAIL=audit@exemplo.com

# =============================================================================
# 🚀 CONFIGURAÇÕES DO SISTEMA
# =============================================================================
# URL do servidor MCP (não altere se usar Docker Compose padrão)
MCP_SERVER_URL=http://mcp-server:8080

# =============================================================================
# 🔧 CONFIGURAÇÕES AVANÇADAS (OPCIONAL)
# =============================================================================
# Nível de log (debug, info, warning, error)
LOG_LEVEL=info

# Timeout para requisições (em segundos)
REQUEST_TIMEOUT=30

# =============================================================================
# 📊 CONFIGURAÇÕES DE MONITORAMENTO (OPCIONAL)
# =============================================================================
# Intervalo de coleta de métricas (em segundos)
SCRAPE_INTERVAL=15

# Retenção de dados (em dias)
RETENTION_DAYS=30

# =============================================================================
# 🚨 CONFIGURAÇÕES DE ALERTAS (OPCIONAL)
# =============================================================================
# Tempo de resolução de alertas (em minutos)
ALERT_RESOLUTION_TIME=5

# =============================================================================
# 📝 INSTRUÇÕES DE USO
# =============================================================================
# 1. Copie este arquivo: cp env.example .env
# 2. Edite o arquivo .env com seus valores reais
# 3. NUNCA comite o arquivo .env no GitHub
# 4. Mantenha este arquivo env.example atualizado
# =============================================================================
